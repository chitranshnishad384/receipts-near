# Copy to web/.env.local to override. Do not commit web/.env.local.
# Leave VITE_RELAYER_URL unset for the Cloudflare Pages build.
# The production bundle then has no relayer origin and does not request one.
# Set it only when scripts/relayer.mjs (or a deployed worker) is actually running:
# VITE_RELAYER_URL=http://127.0.0.1:8788
VITE_RELAYER_URL=
